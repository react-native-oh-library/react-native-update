{
  "name": "@oh-rn/react-native-update",
  "displayName": "@oh-rn/react-native-update",
  "version": "10.56.1",
  "description": "react-native hot update",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "types": "./dist/typescript/index.d.ts",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactnativecn/react-native-update.git"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/reactnativecn/react-native-update#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "harmony/"
  ],
  "scripts": {
    "prepare": "tsc --noEmit && bob build",
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name update --cpp-output-path ./harmony/update/src/main/cpp/generated --ets-output-path ./harmony/update/src/main/ets/generated --turbo-modules-spec-paths ./src/specs/v1/NativePushy.ts"
  },
  "peerDependencies": {
    "react-native": ">=0.72",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-update",
    "autolinking": {
      "cmakeLibraryTargetName": "update",
      "ohPackageName": "@oh-rn/react-native-update",
      "etsPackageClassName": "UpdatePackage",
      "cppPackageClassName": "UpdatePackage"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "dependencies": {
    "nanoid": "^3.3.3"
  }
}
